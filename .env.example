# Copy to .env for local development. On Vercel, add these under Project → Settings → Environment Variables.

# MongoDB Atlas connection string (free M0 cluster is enough). Without it, local dev keeps data in memory.
MONGODB_URI=
MONGODB_DB=samarpita

# Long random string (at least 32 characters) used to sign admin login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# First admin account, created automatically when no admin exists yet. Optional: without these the
# default login samarpitateam@gmail.com / Samarpita@2026 is created and the admin panel insists on a
# password change. Either way, change the password from the admin panel (Security tab) after first login.
ADMIN_EMAIL=samarpitateam@gmail.com
ADMIN_PASSWORD=

# Hours an admin stays signed in (default 8)
SESSION_HOURS=8

# Email notifications for new messages, donor registrations and feedback (optional but recommended).
# Free option: the team's Gmail with an App Password (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=samarpitateam@gmail.com
SMTP_PASS=
# Where the notifications are delivered (defaults to SMTP_USER)
MAIL_TO=samarpitateam@gmail.com
